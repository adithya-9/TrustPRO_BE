# Copy to .env and adjust. Never commit the real .env.

# --- Database (existing trustmate database, epsoft schema) ---
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/trustmate
DB_SCHEMA=epsoft

# --- Application ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Storage (relative paths are resolved from the backend folder) ---
STORAGE_DIR=storage
MODELS_DIR=models
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=2147483648

# --- Sessions / secrets ---
SESSION_TTL_HOURS=12
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# --- AI runtime ---
# ONNX Runtime providers in priority order; CPU is always the fallback.
# For an NVIDIA GPU install onnxruntime-gpu and use: CUDAExecutionProvider,CPUExecutionProvider
ONNX_PROVIDERS=CPUExecutionProvider
INFERENCE_THREADS=3
# arcface (best accuracy, non-commercial weights) or sface (Apache-2.0). See docs/MODEL_SELECTION.md
FACE_ENGINE=arcface
ARCFACE_MATCH_THRESHOLD=0.40
SFACE_MATCH_THRESHOLD=0.363

# --- Objects / environment ---
# Report analysis: rfdetr_m (RF-DETR Medium, most accurate), rfdetr_s, rfdetr_n or dfine_s (D-FINE Small)
OBJECT_MODEL=rfdetr_m
# Live checks during the interview: rfdetr_s (RF-DETR Small, faster per frame); rfdetr_n for slow PCs
LIVE_OBJECT_MODEL=rfdetr_s
# OpenVINO parallel streams for report analysis (0 = automatic)
OBJECT_STREAMS=0
LIVE_OBJECT_THREADS=2
PHONE_MIN_CONFIDENCE=0.45
PHONE_MIN_SIZE_FACE_RATIO=0.35
# Phone-like detections at ear level beside the face (headphone cups) need this much confidence
PHONE_EAR_MIN_CONFIDENCE=0.65
PERSON_MIN_HEIGHT_RATIO=0.45
SCREEN_MIN_AREA_RATIO=0.06

# --- Live monitoring ---
# Checks run back to back, at most this often; a strong phone/person detection warns at once
LIVE_ENVIRONMENT_INTERVAL_S=0.5
LIVE_ENVIRONMENT_CONFIRMATIONS=2

# --- Gaze (relative to each candidate's countdown calibration) ---
GAZE_HORIZONTAL_DEG=20
GAZE_HORIZONTAL_EYES_DEG=14
# UP must be above max(GAZE_UP_DEG, camera + GAZE_UP_CAMERA_MARGIN_DEG): looking at the camera is forward
GAZE_UP_DEG=20
GAZE_UP_CAMERA_MARGIN_DEG=12
# DOWN: eyes rolled down (MediaPipe eyeLookDown rise), head bent down, or gaze below the screen
GAZE_DOWN_EYES=0.30
GAZE_DOWN_HEAD_DEG=15
GAZE_DOWN_PITCH_DEG=6
GAZE_MIN_STATE_MS=550

# --- Post-interview analysis ---
ANALYSIS_SAMPLE_INTERVAL_S=3.0
ANALYSIS_CONFIRM_OFFSET_S=0.4
ANALYSIS_MIN_EVENT_FRAMES=2
ANALYSIS_JOB_WORKERS=1
